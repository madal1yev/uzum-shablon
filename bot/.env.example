# Telegram bot tokeni (BotFather'dan olingan)
BOT_TOKEN=

# Google Gemini API kaliti (https://aistudio.google.com/apikey)
# Bo'sh qoldirsangiz — fallback matnlar ishlatiladi, bot baribir ishlaydi.
GEMINI_API_KEY=

# Foydalaniladigan Gemini modeli
GEMINI_MODEL=gemini-2.0-flash

# Interfeys tili: uz | ru | en
DEFAULT_LANG=uz

# Fondan ajratish (rembg) — 1 = yoqilgan, 0 = o'chirilgan
USE_REMBG=1

# rembg modeli (birinchi marta ~170 MB yuklab olinadi)
REMBG_MODEL=u2net

# Bir vaqtda ishlaydigan og'ir vazifalar soni
MAX_PARALLEL=2
