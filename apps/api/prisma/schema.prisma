generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProcessingMode {
  STANDARD_RESIZE
  PRODUCT_CLEANUP
  AI_PRODUCT_DESIGN
  PRODUCT_INFOGRAPHICS
}

enum AssetKind {
  UPLOADED
  GENERATED
}

enum CreditTxType {
  GRANT
  RESERVE
  CHARGE
  REFUND
  ADMIN_ADJUST
  EXPIRE
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYME
  CLICK
  STRIPE
  MANUAL
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            Role      @default(USER)
  locale          String    @default("uz")
  banned          Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  sessions            Session[]
  passwordResets      PasswordResetToken[]
  connections         AccountConnection[]
  assets              Asset[]
  jobs                GenerationJob[]
  ledger              CreditLedger[]
  balance             CreditBalance?
  subscription        Subscription?
  payments            Payment[]
  notifications       Notification[]
  auditLogs           AuditLog[]        @relation("AuditActor")
  providerUsage       ProviderUsage[]

  @@index([createdAt])
  @@map("users")
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AccountConnection {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  externalId String
  username   String?
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
  @@map("account_connections")
}

model Asset {
  id          String    @id @default(uuid())
  userId      String
  kind        AssetKind
  jobId       String?
  storageKey  String
  mime        String
  format      String
  width       Int
  height      Int
  bytes       Int
  sha256      String?
  originalName String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  GenerationJob?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, kind, createdAt])
  @@index([jobId])
  @@map("assets")
}

model ImagePreset {
  id          String   @id @default(uuid())
  key         String   @unique
  nameUz      String
  nameRu      String
  nameEn      String
  width       Int
  height      Int
  aspectRatio String
  builtin     Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs GenerationJob[]

  @@map("image_presets")
}

model GenerationJob {
  id             String         @id @default(uuid())
  userId         String
  mode           ProcessingMode
  status         JobStatus      @default(QUEUED)
  presetId       String?
  sourceAssetId  String?
  width          Int
  height         Int
  format         String
  fit            String
  padding        Int            @default(6)
  background     String         @default("#FFFFFF")
  style          String?
  variations     Int            @default(1)
  progress       Int            @default(0)
  cost           Int            @default(0)
  idempotencyKey String?
  failureCode    String?
  failureMessage String?
  meta           Json?
  attempts       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset      ImagePreset?  @relation(fields: [presetId], references: [id], onDelete: SetNull)
  assets      Asset[]
  ledger      CreditLedger[]
  usage       ProviderUsage[]
  events      JobEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("generation_jobs")
}

model JobEvent {
  id        String   @id @default(uuid())
  jobId     String
  stage     String
  message   String?
  data      Json?
  createdAt DateTime @default(now())

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_events")
}

model CreditBalance {
  userId    String   @id
  balance   Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id             String        @id @default(uuid())
  userId         String
  jobId          String?
  amount         Int
  type           CreditTxType
  balanceAfter   Int
  idempotencyKey String?       @unique
  note           String?
  actorUserId    String?
  createdAt      DateTime      @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  GenerationJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("credit_ledger")
}

model PricingRule {
  id        String         @id @default(uuid())
  mode      ProcessingMode @unique
  cost      Int            @default(0)
  active    Boolean        @default(true)
  updatedAt DateTime       @updatedAt

  @@map("pricing_rules")
}

model CreditPackage {
  id        String   @id @default(uuid())
  key       String   @unique
  nameUz    String
  nameRu    String
  nameEn    String
  credits   Int
  priceUzs  Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_packages")
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  status             SubscriptionStatus @default(NONE)
  planKey            String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("subscriptions")
}

model Payment {
  id          String          @id @default(uuid())
  userId      String
  provider    PaymentProvider
  providerRef String?         @unique
  amount      Int
  currency    String          @default("UZS")
  status      PaymentStatus   @default(PENDING)
  credits     Int             @default(0)
  packageKey  String?
  payload     Json?
  createdAt   DateTime        @default(now())
  settledAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payments")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  externalId  String
  signature   String?
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, externalId])
  @@map("webhook_events")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  target      String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

model ProviderUsage {
  id        String   @id @default(uuid())
  userId    String?
  jobId     String?
  provider  String
  operation String
  model     String?
  units     Int      @default(1)
  latencyMs Int?
  ok        Boolean
  error     String?
  createdAt DateTime @default(now())

  user User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  job  GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([provider, ok])
  @@map("provider_usage")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
