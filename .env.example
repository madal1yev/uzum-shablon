# ============================================================
# MarketPix AI — environment configuration (template)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- Runtime ----
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
PUBLIC_APP_URL=http://localhost:3000
API_PREFIX=/api/v1
# Comma separated. Empty = same-origin only.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ---- PostgreSQL ----
# Local dev example: postgresql://postgres:password@127.0.0.1:5432/marketpix
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/marketpix

# ---- Redis (BullMQ queue) ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth (generate long random strings, e.g. `openssl rand -hex 32`) ----
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# ---- Object storage ----
# local = files under LOCAL_STORAGE_DIR (good for development)
# s3    = S3-compatible bucket (required for production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=600

# ---- AI providers ----
# AI_PROVIDER=none means AI modes are disabled and the API returns a clear
# configuration error. Standard resize / format conversion still works.
# Supported: none | openai | removebg
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGES_MODEL=gpt-image-1
REMOVE_BG_API_KEY=
REMOVE_BG_BASE_URL=https://api.remove.bg/v1.0

# ---- Queue / jobs ----
QUEUE_GENERATION_CONCURRENCY=2
JOB_TIMEOUT_MS=180000
JOB_MAX_ATTEMPTS=3

# ---- Credits ----
FREE_TRIAL_CREDITS=25
COST_STANDARD_RESIZE=0
COST_PRODUCT_CLEANUP=1
COST_AI_PRODUCT_DESIGN=3
COST_PRODUCT_INFOGRAPHICS=1

# ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Secret used to sign web-account linking payloads.
TELEGRAM_LINK_SECRET=

# ---- Payments ----
# none | payme | click | stripe | manual
# Leave as `none` until a merchant account and webhook docs are verified.
PAYMENT_PROVIDER=none
PAYME_WEBHOOK_SECRET=
CLICK_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# ---- Rate limiting / retention ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RETENTION_DAYS=30

# ---- Telegram bot app ----
# Must point at the running API.
TELEGRAM_API_BASE_URL=http://127.0.0.1:3001/api/v1
TELEGRAM_LINK_CALLBACK_SECRET=

# ---- Web app ----
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
